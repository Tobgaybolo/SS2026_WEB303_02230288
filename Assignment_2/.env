# Demo-only development values. Do not reuse these credentials anywhere real.

# Gateway
GATEWAY_PORT=8080
UPSTREAM_TIMEOUT=10s

# Shared Postgres internal port
DB_PORT=5432

# Catalog service (Service B) and its own database
CATALOG_GRPC_PORT=50051
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalogpass
CATALOG_DB_NAME=catalog_db

# Purchase service (Service A) and its own database
PURCHASE_GRPC_PORT=50052
PURCHASE_DB_USER=purchases
PURCHASE_DB_PASSWORD=purchasespass
PURCHASE_DB_NAME=purchases_db

# Purchase -> Catalog resilience settings
CATALOG_TIMEOUT=1s
CATALOG_MAX_ATTEMPTS=3
CATALOG_RETRY_BASE=100ms
CATALOG_BREAKER_THRESHOLD=3
CATALOG_BREAKER_OPEN_TIMEOUT=10s